# Copy to .env.local and fill in when connecting a live backend (Phase 7/8).
# Until these are set, the app runs on the typed local data adapter.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for canonical URLs, sitemap, OG). Defaults to localhost in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
